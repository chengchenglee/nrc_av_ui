  <link name="LR_wheel">
    <visual>
	<origin xyz="0 0 0" rpy="0 0 0"/>
	<geometry>
	  <mesh filename="package://nrc_svcs/src/nrc_car_description/leaf_tire.dae"/>
	</geometry>
    </visual>
  </link>
  
  <link name="RR_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
	<mesh filename="package://nrc_svcs/src/nrc_car_description/leaf_tire.dae"/>
      </geometry>
    </visual>
  </link>
  
  <link name="LF_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
	<mesh filename="package://nrc_svcs/src/nrc_car_description/leaf_tire.dae"/>
