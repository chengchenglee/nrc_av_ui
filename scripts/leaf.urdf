	<mesh filename="package://nrc_svcs/src/nrc_car_description/leaf_tire.dae"/>
      </geometry>
    </visual>
  </link>
  
  
  
  <link name ="LF_steer"/>
  <link name ="RF_steer"/>
 
    

  <joint name="car_LF_steer" type="continuous">
    <parent link="car"/>
    <child link="LF_steer"/>
    <origin xyz="2.628 0.81 0.32" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  
  <joint name="car_RF_steer" type="continuous">
    <parent link="car"/>
    <child link="RF_steer"/>
    <origin xyz="2.632 -0.81 0.32" rpy="0 0 3.14159"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="car_LR_wheel" type="continuous">
    <parent link="car"/>
    <child link="LR_wheel"/>
    <origin xyz="-.052 0.81 0.32" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  
  <joint name="car_RR_wheel" type="continuous">
    <parent link="car"/>
    <child link="RR_wheel"/>
    <origin xyz="-0.048 -0.81 0.32" rpy="0 0 3.14159"/>
    <axis xyz="0 -1 0"/>
  </joint>
  
  <joint name="LF_steer_LF_wheel" type="continuous">
    <parent link="LF_steer"/>
    <child link="LF_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  
  <joint name="RF_steer_RF_wheel" type="continuous">
    <parent link="RF_steer"/>
    <child link="RF_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
  </joint>
  
  
 

  
  <!-- Gazebo -->
  
  <gazebo reference="car">
    <material>Gazebo/Blue</material>
    <turnGravityOff>false</turnGravityOff>
  </gazebo>
    
  <gazebo reference="hokuyo_rear_right">
    <sensor type="ray" name="lidar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>40</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-1.570796</min_angle>
            <max_angle>1.570796</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.10</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_head_hokuyo_controller" filename="libgazebo_ros_laser.so">
        <topicName>/sensor/lrf/rear_right</topicName>
        <frameName>hokuyo_rear_right</frameName>
      </plugin>
    </sensor>
  </gazebo>
  
</robot>
