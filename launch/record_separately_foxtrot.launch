<launch>

  <machine name="local" address="localhost"/>
  <machine name="node02" address="node02" env-loader="$(find nrc_svcs)/launch/env.sh" />
  <machine name="node03" address="node03" env-loader="$(find nrc_svcs)/launch/env.sh" />
  <arg name="record_machine" default="local" />
  <arg name="record_raw_machine" default="local"/>
  <arg name="suffix" default="" />

  <!-- Enable / Disable subsystem recording -->
  <arg name="record_system_front_tower_cameras" default="true"/>
  <arg name="record_system_back_tower_cameras" default="true"/>
  <arg name="record_system_lidar" default="false"/>
  <arg name="record_system_lidar_raw" default="true"/>
  <arg name="record_system_main" default="true"/>
  <arg name="record_pc_processor_all" default="true"/>
  <arg name="record_wm_all" default="true"/>
  <arg name="record_dm_all" default="true"/>
  <arg name="record_ralp_all" default="true"/>
  <arg name="record_ralp_follower" default="true"/>
  <arg name="record_validation" default="false"/>
  
  <arg name="prefix" default="autonomy_log" />
  <arg name="compression" default="false" /> <!--bz2 compression -->

  <arg name="system_front_tower_cameras_topics"
  default="/tower_cam_front/image_raw/compressed
  |/tower_cam_frontRight/camera_out/image_raw/compressed
  |/tower_cam_frontLeft/camera_out/image_raw/compressed
  |/trigger_signal"/>
  
  <arg name="system_back_tower_cameras_topics"
  default="/tower_cam_backRight/camera_out/image_raw/compressed
  |/tower_cam_backLeft/camera_out/image_raw/compressed
  |/tower_cam_back/camera_out/image_raw/compressed"/>
  
  <arg name="system_lidar_raw_topics"
  default="/velodyne_packets"/>
  
  <arg name="system_lidar_topics"
  default="/velodyne_packets
  |/pc_processor/labeled_pc
  |/luminar_front/pointCloud
  |/luminar_left/pointCloud
  |/luminar_right/pointCloud
  |/detection_recog_results/tower_cam_front
  |/detection_recog_results/tower_cam_frontLeft
  |/detection_recog_results/tower_cam_frontRight
  |/detection_recog_results/tower_cam_back
  |/detection_recog_results/tower_cam_backLeft
  |/detection_recog_results/tower_cam_backRight
  |/radar
  |/radar_bf
  |/multi_object_tracker/timing/overall_processing_time
  |/multi_object_tracker/timing/timing_diagnostics
  |/pc_processor/timing/overall_processing_time
  |/pc_processor/timing/timing_diagnostics"/>

  <arg name="system_main_topics" 
  default="/dynamic_global_pose
  |/NavSatFix_f9r
  |/Imu_f9r
  |/Twist_f9r
  |/GpsDiag_f9r
  |/f9p(.*)
  |/gps_state(.*)
  |/MapMatch_offset
  |/ME3_ObjData
  |/ME3_LKA_left
  |/ME3_LKA_right
  |/ME4_Lanes
  |/ME4_Road_Edges
  |/ME4_ObjData
  |/ME4_Obj_rviz
  |/ME4_SLD_Lines
  |/ME4_SLD_Lines_rviz
  |/ME4_TFL_Spot_Array
  |/ME4_TFL_Structure_Array
  |/ME4_TFL_rviz
  |/ME4_TSR
  |/ME4_(.*)
  |/ME5_(.*)
  |/Mobileye4_CANData
  |/Mobileye5_CANData
  |/ME4_Path_Prediction
  |/drive_goals_with_lanes_from_lane_markings
  |/drive_goals_with_lanes_from_BE
  |/ContiRadar_ObjData
  |/controller_state
  |/CtrlStateFLG
  |/driver_input
  |/Radar_ObjData
  |/smartmicro_output
  |/smartmicro_tracked_objects
  |/CAN/Odometry
  |/CAN/OdometryInput
  |/CAN_V_reader
  |/accel_state
  |/bsm
  |/psm
  |/intent
  |/alert
  |/ladyBugs
  |/ibeo_object_set
  |/radar
  |/radar_bf
  |/ailsv_av_status
  |/ailsv_teleop"/>
  
  <arg name="pc_processor_all_topics" 
  default="/drivable_area_boundary_points
  |/drivable_area_boundary_points_with_edge_points
  |/drivable_area_boundary_points_raw
  |/pc_processor/multi_object_tracker/tracked_object_set
  |/pc_processor/visible_space/visible_space_ray_points
  |/visible_space_data
  |/visible_space_fused_data
  |/visible_space_peer_data
  |/bevfusion/pc_object_set_with_fusion
  |/bevfusion_objects
  |/bevfusion/tracked_object_set"/>
  
  <arg name="wm_all_topics" 
  default="/swm_node
  |/tlStatus
  |/drivable_area_filtered
  |/master_filter/object_database
  |/dds_object_databse_fused_data
  |/ailsv_tracked_objects
  |/ailsv_predicted_trajectories
  |/prediction_error"/>
  
  <arg name="dm_lite_topics" 
  default="/drive_plan
  |/route_plan"/>
  
  <arg name="dm_all_topics" 
  default="|/modia/(.*)
  |/humanising_autonomy
  |/humanising_autonomy/(.*)
  |/route_plan/(.*)
  |/drive_plan
  |/traffic_light_state
  |/traffic_light/detection
  |/smart_eye_driver_state
  |/intelligent_pedal
  |/abstractors/information/center_line_points
  |/woz/keystroke"/>

<arg name="ipt_topics"
  default="/gps_state
  |/raw_nmea
  |/dynamic_global_pose
  |/dynamic_global_pose_conv
  |/evcan_data
  |/vcan_data
  |/serena/epower_status
  |/serena/engine_request
  "/>

<arg name="ignore_dm_topics"
  default="/modia/information/blocking(.*)"/>

  <arg name="ralp_all_topics"
  default="/lane_planner_state
  |/lane_planner_desired_path
  |/lane_planner_planned_path
  |/longPath
  |/planned_path
  |/vehicle_trajectory_control
  |/SpeedPlan
  |/hazard_zone
  |/SpeedPlanOccGridPanel
  |/point_of_no_return
  |/ailsv_osp_merge
  |/prm/reference_path_data
  |/prm/osp_constraints_lv_ids
  |/prm/risk_classifier_output
  |/metrics"/>

  <arg name="ralp_follower_topics"
  default="|/lane_follower_state
  |/control_inputs
  |/combined_control
  |/cbf_override
  |/cbf_boundaries_publisher
  |/force_steering_components
  |/stanley_control
  |/lane_planner_combined_control_debug
  |/hyperdrive_display_publisher
  |/hyperdrive_debug_publisher
  |/hyperdrive_outputs
  |/hyperdrive_tube_output
  |/hyperdrive_blockage"/>  

  <node if="$(arg record_system_front_tower_cameras)" pkg="nrc_av_ui" type="rosbagrecord.sh" name="rosbag_record_front_cameras" output="screen"
  args="$(arg compression) -o $(arg prefix)_system_front_cameras -e $(arg system_front_tower_cameras_topics)"  machine="$(arg record_raw_machine)"/>
  
  <node if="$(arg record_system_back_tower_cameras)" pkg="nrc_av_ui" type="rosbagrecord.sh" name="rosbag_record_back_cameras" output="screen"
  args="$(arg compression) -o $(arg prefix)_system_back_cameras -e $(arg system_back_tower_cameras_topics)" machine="$(arg record_raw_machine)"/>

  <node if="$(arg record_system_lidar_raw)" pkg="nrc_av_ui" type="rosbagrecord.sh" name="rosbag_record_lidar_raw" output="screen"
  args="-o $(arg prefix)_system_lidar_raw -e $(arg system_lidar_raw_topics)" machine="$(arg record_raw_machine)"/>
  
  <node if="$(arg record_system_lidar)" pkg="nrc_av_ui" type="rosbagrecord.sh" name="rosbag_record_system_lidar" output="screen"
  args="-o $(arg prefix)_system_lidar -e $(arg system_lidar_topics)" machine="$(arg record_machine)"/>

  <node if="$(arg record_system_main)" pkg="nrc_av_ui" type="rosbagrecord.sh" name="rosbag_record_for_system_main" output="screen"
  args="$(arg compression) -o $(arg prefix)_system_main -e $(arg system_main_topics)" machine="$(arg record_machine)"/>  
    
  <node if="$(arg record_pc_processor_all)" pkg="nrc_av_ui" type="rosbagrecord.sh" name="rosbag_record_pc_processor_all" output="screen"
  args="$(arg compression) -o $(arg prefix)_pc_processor_all -e $(arg pc_processor_all_topics)" machine="$(arg record_machine)"/>  

  <node if="$(arg record_wm_all)" pkg="nrc_av_ui" type="rosbagrecord.sh" name="rosbag_record_wm_all" output="screen"
  args="$(arg compression) -o $(arg prefix)_wm_all -e $(arg wm_all_topics)" machine="$(arg record_machine)"/>
 
  <node if="$(arg record_dm_all)" pkg="nrc_av_ui" type="rosbagrecord.sh" name="rosbag_record_dm_all" output="screen"
  args="$(arg compression) -o $(arg prefix)_dm_all -e $(arg dm_all_topics) -x $(arg ignore_dm_topics)" machine="$(arg record_machine)"/>   
 
  <node if="$(arg record_ralp_all)" pkg="nrc_av_ui" type="rosbagrecord.sh" name="rosbag_record_ralp_all" output="screen"
  args="$(arg compression) -o $(arg prefix)_ralp_all -e $(arg ralp_all_topics)" machine="$(arg record_machine)"/>   

  <node if="$(arg record_ralp_follower)" pkg="nrc_av_ui" type="rosbagrecord.sh" name="rosbag_record_ralp_follower" output="screen"
  args="$(arg compression) -o $(arg prefix)_ralp_follower -e $(arg ralp_follower_topics)" machine="$(arg record_machine)"/>   
  
  <node if="$(arg record_validation)" pkg="nrc_av_ui" type="rosbagrecord.sh" name="rosbag_record_validation" output="screen"
  args="$(arg compression) -o $(arg prefix)_validation_$(arg suffix) -e $(arg validation_topics)" machine="$(arg record_machine)"/>   
  
  <node pkg="nrc_av_ui" type="rosbagRecordMonitor.py" name="RosbagMonitor" args="-d /opt/data/rosbag/ -t BagfileHealth" machine="$(arg record_machine)" output="screen"/>

</launch>
