<launch>

  <machine name="local" address="localhost"/>
  <machine name="node02" address="node02" env-loader="$(find nrc_svcs)/launch/env.sh" />
  <arg name="record_machine" default="local" />
  <arg name="suffix" default="" />

  <arg name="record_disengagement_snapshots" default="true"/> <!-- turn this on for snapshot rosbags during disengagement/override-->
  
  <arg name="prefix" default="autonomy_log" />
  <arg name="compression" default="false" /> <!--bz2 compression -->

  <!-- (.*) does not work with snapshot rosbag command. So added a seperate snapshot main topics-->
  <arg name="snapshot_system_main_topics"
  default="|/CAN_V_reader
  |/CtrlStateFLG
  |/ME3_LKA_left
  |/ME3_LKA_right
  |/ME3_ObjData
  |/ME5_Construction_Objects
  |/ME5_Lanes
  |/ME5_Lanes_rviz
  |/ME5_ObjData
  |/ME5_Obj_rviz
  |/ME5_Path_Prediction
  |/ME5_Reflective_Signs
  |/ME5_Reflective_Vehicles
  |/ME5_Road_Edges
  |/ME5_Semantic_Lanes
  |/ME5_Semantic_Lines
  |/ME5_Semantic_Marks
  |/ME5_TFL_rviz
  |/ME5_TrafficLight
  |/Mobileye5_CANData
  |/Pose_gps
  |/ailsv_av_status
  |/controller_state
  |/driver_input
  |/dynamic_global_pose
  |/dynamic_global_pose_conv
  |/dynamic_global_pose_odo
  |/dynamic_global_pose_odoGps
  |/gps_state/dynamic_global_pose_f9r
  |/gps_state/gps_state_f9r
  |/gps_state/dynamic_global_pose_oxts
  |/gps_state/gps_state_oxts
  |/gps_state/gps_state_ariya"/>
  
  <arg name="snapshot_system_front_tower_cameras_topics"
  default="|/monitor_cam_front/image_stamped/compressed
  |/vehicle_state_ros
  |/tower_cam_front/image_stamped/compressed
  |/front_camera/image_color/compressed
  |/lucid_cam_front/image_rect_color/compressed
  |/lucid_cam_front_left/image_rect_color/compressed
  |/lucid_cam_front_right/image_rect_color/compressed"/>
  
  <arg name="snapshot_system_lidar_topics"
  default="/velodyne_packets
  |/velodyne_points
  |/luminar_front/pointCloud
  |/luminar_left/pointCloud
  |/luminar_right/pointCloud"/>
  
  <arg name="snapshot_pc_processor_all_topics" 
  default="/drivable_area_boundary_points
  |/drivable_area_boundary_points_with_edge_points
  |/drivable_area_boundary_points_raw
  |/pc_processor/multi_object_tracker/tracked_object_set
  |/visible_space_data
  |/visible_space_fused_data
  |/visible_space_peer_data"/>
  
  <arg name="snapshot_wm_all_topics" 
  default="/swm_node
  |/tlStatus
  |/drivable_area_filtered
  |/master_filter/object_database
  |/dds_object_databse_fused_data
  |/ailsv_tracked_objects
  |/ailsv_predicted_trajectories"/>

  <arg name="snapshot_ralp_all_topics"
  default="/lane_planner_state
  |/lane_planner_desired_path
  |/lane_planner_planned_path
  |/longPath
  |/planned_path
  |/vehicle_trajectory_control
  |/SpeedPlan
  |/hazard_zone
  |/SpeedPlanOccGridPanel
  |/point_of_no_return
  |/ailsv_osp_merge
  |/drive_plan
  |/autoGoals_debug"/>
  
  <!--Run snapshot buffer shell script-->
  <node if="$(arg record_disengagement_snapshots)" pkg="nrc_svcs" type="rosbagSnapshot.sh" name="rosbag_snapshot" output="screen"
  args="$(arg snapshot_system_front_tower_cameras_topics) $(arg snapshot_system_main_topics) $(arg snapshot_pc_processor_all_topics) $(arg snapshot_wm_all_topics) $(arg snapshot_ralp_all_topics)"/>

  <!--Run snapshot node-->
  <node pkg="nrc_av_ui" type="Snapshot_Trigger.py" name="trigger_node" output="screen"/>

</launch>