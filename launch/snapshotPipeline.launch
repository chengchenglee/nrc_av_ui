<launch>

  <machine name="local" address="localhost"/>
  <machine name="node02" address="node02" env-loader="$(find nrc_svcs)/launch/env.sh" />
  <arg name="snapshot_machine"  default="local" />

  <arg name="recordSnapshots"   default="True"/>
  <arg name="recordBmapData"    default="False"/>
  <arg name="checkEngaged"      default="True" />
  <arg name="car"               default="Foxtrot" />
  <arg name="snapshotDirectory" default="/opt/data/snapshots"/>

  <!-- (.*) does not work with snapshot rosbag command. So added a seperate snapshot main topics-->
  <arg name="snapshot_system_main_topics"
  default="|/CAN_V_reader
  |/CtrlStateFLG
  |/ME5_Construction_Objects
  |/ME5_Lanes
  |/ME5_Lanes_rviz
  |/ME5_ObjData
  |/ME5_Obj_rviz
  |/ME5_Path_Prediction
  |/ME5_Reflective_Signs
  |/ME5_Reflective_Vehicles
  |/ME5_Road_Edges
  |/ME5_Semantic_Lanes
  |/ME5_Semantic_Lines
  |/ME5_Semantic_Marks
  |/ME5_TFL_rviz
  |/ME5_TrafficLight
  |/Pose_gps
  |/ailsv_av_status
  |/ard_state
  |/pmu_state
  |/controller_state
  |/driver_input
  |/dynamic_global_pose
  |/gps_state/dynamic_global_pose_f9r
  |/gps_state/gps_state_f9r
  |/gps_state/dynamic_global_pose_oxts
  |/gps_state/gps_state_oxts
  |/gps_state/gps_state_ariya"/>
  
  <arg name="snapshot_system_front_tower_cameras_topics"
  default="/snapshot/image/compressed
  |/tower_cam_front/image_cropped2/compressed"/>
  
  <arg name="snapshot_system_lidar_topics"
  default="/velodyne_packets
  |/velodyne_points
  |/luminar_front/pointCloud
  |/luminar_left/pointCloud
  |/luminar_right/pointCloud"/>
  
  <arg name="snapshot_pc_processor_all_topics" 
  default="/drivable_area_boundary_points
  |/pc_processor/multi_object_tracker/tracked_object_set
  |/pc_processor/visible_space/visible_space_ray_points
  |/bevfusion/tracked_object_set"/>
  
  <arg name="snapshot_wm_all_topics" 
  default="/tlStatus
  |/master_filter/object_database
  |/dds_object_databse_fused_data
  |/ailsv_tracked_objects
  |/ailsv_predicted_trajectories
  |/prediction_error"/>

  <arg name="snapshot_ralp_all_topics"
  default="/lane_planner_state
  |/lane_planner_desired_path
  |/lane_planner_planned_path
  |/longPath
  |/planned_path
  |/vehicle_trajectory_control
  |/SpeedPlan
  |/hazard_zone
  |/SpeedPlanOccGridPanel
  |/point_of_no_return
  |/ailsv_osp_merge
  |/drive_plan
  |/autoGoals_debug
  |/lead_vehicle
  |/prm/reference_path_data
  |/prm/osp_constraints_lv_ids"/>

  <arg name="cubtek_topics"
  default="/cubtek_PC_rviz_R
  |/cubtek_PC_rviz_L
  |/cubtek_trackedobjects_filter_out
  |/cubtek_raw_points
  |/ariya_back_radar_tracked_objects"/>
  
  <arg name="bmap_topics"
  default="/bmap_recorder/data"/>
  
  <group if="$(arg recordSnapshots)">
    <!--Snapshot trigger node-->
    <node pkg="nrc_av_ui" type="Snapshot_Trigger.py" name="snapshot_trigger_node" output="screen" args="-e $(arg checkEngaged) -c $(arg car)"/>
    
    <!--Snapshot bagfile recorder-->
    <node pkg="nrc_av_ui" type="rosbagSnapshot.sh" name="rosbag_snapshot" output="screen"
    args="$(arg snapshot_system_front_tower_cameras_topics) $(arg snapshot_system_main_topics) $(arg snapshot_pc_processor_all_topics) $(arg snapshot_wm_all_topics) $(arg snapshot_ralp_all_topics) $(arg cubtek_topics)"/>
    
    <node pkg="nrc_av_ui" type="rosbagRecordMonitor.py" name="snapshot_monitor" args="-d ~/projects/disengagementData/bags/ -t SnapshotHealth -n SnapshotMonitor -m Trigger" machine="$(arg snapshot_machine)" output="screen"/>

    
    <node if="False" name="snapshot" pkg="nodelet" type="nodelet"
        args="standalone image_proc/resize" output="screen">
        <remap from="image" to="/tower_cam_front/image_stamped" />
        <remap from="camera_info" to="/tower_cam_front/camera_info" />
        <param name="scale_width" value="0.4" />
        <param name="scale_height" value="0.4" />
    </node>
  </group>

  <group if="$(arg recordBmapData)">
    <!--Bmap data collector-->
    <node pkg="nrc_av_ui" type="bmapDataCollector.py" name="bmap_data_collector" output="screen"/>
    
    <!--Bmap bagfile recorder-->
    <node pkg="nrc_av_ui" type="rosbagrecord2.sh" name="rosbag_bmap_data" output="screen"
    args="-p $(arg snapshotDirectory) -c --lz4 -o bmap_log -e $(arg bmap_topics) -d 10m"  machine="$(arg snapshot_machine)"/>  
  </group>

</launch>
